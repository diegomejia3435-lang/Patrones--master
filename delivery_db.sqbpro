<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="delivery_db.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2261"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="catalogo_tienda" custom_title="0" dock_id="1" table="4,15:maincatalogo_tienda"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011e00ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE catalogo_tienda (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    categoria TEXT NOT NULL,
    precio REAL NOT NULL,
    requiere_preparacion INTEGER NOT NULL DEFAULT 0,
    opciones_disponibles TEXT,
    stock INTEGER NOT NULL DEFAULT 0
);


CREATE TABLE ordenes (
    id_orden INTEGER PRIMARY KEY AUTOINCREMENT,
    fecha_pedido TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    total REAL NOT NULL,
    metodo_pago TEXT NOT NULL,
    estado_actual TEXT NOT NULL DEFAULT 'En Espera'
);

CREATE TABLE detalle_orden (
    id_detalle INTEGER PRIMARY KEY AUTOINCREMENT,
    id_orden INTEGER NOT NULL,
    id_producto INTEGER NOT NULL,
    cantidad INTEGER NOT NULL DEFAULT 1,
    precio_unitario REAL NOT NULL,
    opcion_seleccionada TEXT,
    FOREIGN KEY (id_orden) REFERENCES ordenes(id_orden) ON DELETE CASCADE,
    FOREIGN KEY (id_producto) REFERENCES catalogo_tienda(id)
);

